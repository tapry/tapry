{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.local/node/bin:$PATH\"; exec pnpm --filter @tapry/web dev --port 3000"
      ],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.local/node/bin:$PATH\"; exec pnpm --filter @tapry/site dev"
      ],
      "port": 3001
    }
  ]
}
