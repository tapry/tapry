{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src"],
  "exclude": ["node_modules", "out"]
}
