# Postgres connection string. Leave unset for an embedded PGlite database in ./.data/pglite (dev only).
# DATABASE_URL=postgres://tapry:tapry@localhost:5432/tapry

# The first account becomes admin. After that, sign-up is closed unless this is true.
# ALLOW_SIGNUP=false
# Creating the first account asks for this code, so a stranger can't claim a new install. Unset:
# the first visitor to sign up is the admin (fine on your own machine).
# SETUP_TOKEN=change-me-please

# S3-compatible storage (SeaweedFS, Garage, RustFS, AWS S3, Cloudflare R2...)
S3_ENDPOINT=http://localhost:8333
# Endpoint browsers use for uploads, if different from S3_ENDPOINT (e.g. inside Docker Compose).
# S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=tapry
S3_ACCESS_KEY_ID=tapry
S3_SECRET_ACCESS_KEY=tapry-dev-secret
S3_FORCE_PATH_STYLE=true

# Media processing. "inprocess" runs it inside the web server (needed with PGlite);
# "off" when separate workers (node dist-worker/worker.cjs, Postgres only) handle it.
# WORKER=inprocess
# WORKER_POLL_MS=2000
# WORKER_LOCK_SECONDS=600
# Remove each recording's original uploads N days after its files are ready (unset: keep them).
# RAW_RETENTION_DAYS=7
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# The admin health page compares the version with this GitHub repo's latest release
# (unset: no check; nothing is fetched).
# UPDATE_CHECK_REPO=tapry/tapry

# Other sites (comma-separated origins) allowed to use this server's public upload-speed test,
# e.g. the project website. The test page in this app (/tools/upload-speed) always works.
# SPEED_TEST_ORIGINS=https://tapry.app

# A "Record your own, free" link on guests' end screen (unset: no link).
# GUEST_PROMO_URL=https://tapry.app

# Guests can ask for an email with a link to their own recording (unset SMTP_HOST: never offered,
# nothing is ever emailed). Any SMTP server or provider. Encrypted unless SMTP_INSECURE=true.
# APP_URL=https://studio.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Studio <studio@example.com>
# SMTP_INSECURE=false

# Live call (LiveKit). Leave LIVEKIT_URL unset to record without a call.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Own storage: lets accounts record into their own S3-compatible bucket (Storage page). Their
# secret keys are stored encrypted with this; changing it makes them unreadable. Unset: off.
# STORAGE_SECRET_KEY=a-long-random-string
# Accept private and plain-HTTP bucket endpoints (a trusted install on a private network).
# OWN_STORAGE_ALLOW_PRIVATE=false

# Tapry Cloud: plans, recording hours and file retention per account (docs/cloud-billing.md).
# Leave unset on a self-hosted server: no plans, no limits.
# TAPRY_CLOUD=true
# BILLING_PROVIDER=paddle
# BILLING_WEBHOOK_SECRET=
# BILLING_PRICES=pri_abc=creator,pri_def=creator:yearly,pri_xyz=studio
# Paddle: plans are bought on this server's /checkout/<plan> page, which opens Paddle's checkout.
# BILLING_PADDLE_CLIENT_TOKEN=
# Which Paddle account: production (live_ token) or sandbox (test_ token). Required with a
# token or API key; the server refuses to start if it is missing or doesn't match the token.
# BILLING_PADDLE_ENVIRONMENT=production
# The notification destination's SIGNING SECRET (Paddle: Events, Notifications, the destination,
# "Secret key"; starts pdl_ntfset_). It verifies webhooks. It is not the API key.
# BILLING_WEBHOOK_SECRET=pdl_ntfset_…
# The API key, for customer portal sessions (card, invoices, cancelling). A secret: server only.
# BILLING_PADDLE_API_KEY=pdl_live_apikey_…
# Another provider: a checkout address per plan instead.
# BILLING_CHECKOUT_URLS=creator=https://pay.example.com/creator?user_id={user_id}
# BILLING_MANAGE_URL=https://pay.example.com/portal
