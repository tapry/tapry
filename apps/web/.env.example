# Postgres connection string. Leave unset for an embedded PGlite database in ./.data/pglite (dev only).
# DATABASE_URL=postgres://opentake:opentake@localhost:5432/opentake

# The first account becomes admin. After that, sign-up is closed unless this is true.
# ALLOW_SIGNUP=false

# S3-compatible storage (SeaweedFS, Garage, RustFS, AWS S3, Cloudflare R2...)
S3_ENDPOINT=http://localhost:8333
# Endpoint browsers use for uploads, if different from S3_ENDPOINT (e.g. inside Docker Compose).
# S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=opentake
S3_ACCESS_KEY_ID=opentake
S3_SECRET_ACCESS_KEY=opentake-dev-secret
S3_FORCE_PATH_STYLE=true

# Media processing. "inprocess" runs it inside the web server (needed with PGlite);
# "off" when a separate worker process handles it.
# WORKER=inprocess
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Live call (LiveKit). Leave LIVEKIT_URL unset to record without a call.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
