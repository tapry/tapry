{
  "name": "@opentake/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:s3": "node scripts/with-seaweedfs.mjs vitest run test/e2e-s3.test.ts",
    "smoke": "node scripts/with-seaweedfs.mjs node scripts/smoke.mjs",
    "test:e2e": "node scripts/with-seaweedfs.mjs playwright test",
    "build:worker": "esbuild src/worker-main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-worker/worker.cjs --external:pg-native --external:@electric-sql/pglite --log-level=warning",
    "worker": "node dist-worker/worker.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@electric-sql/pglite": "^0.3.0",
    "@opentake/recorder": "workspace:*",
    "@opentake/shared": "workspace:*",
    "@opentake/worker": "workspace:*",
    "client-zip": "2.5.1",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
