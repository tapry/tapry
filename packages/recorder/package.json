{
  "name": "@tapry/recorder",
  "version": "0.2.0",
  "description": "Browser recording core: capture, durable local chunks, resumable upload.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
