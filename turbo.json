{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "FFMPEG_PATH",
        "FFPROBE_PATH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
